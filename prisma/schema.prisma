// Prisma schema for VT K-Factor Growth System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User profiles with privacy and compliance fields
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Privacy & Compliance
  age               Int?
  isMinor           Boolean   @default(false)
  parentalConsent   Boolean   @default(false)
  parentEmail       String?
  coppaCompliant    Boolean   @default(false)
  optedOutGrowth    Boolean   @default(false)
  dataRetentionDate DateTime?
  
  // Simulation tracking
  isSimulated  Boolean @default(false)
  simulationId String?

  // Relations
  sentInvites     SignedLink[]  @relation("Referrer")
  receivedInvites Attribution[] @relation("Referred")
  events          Event[]
  experiments     Experiment[]
  sessions        Session[]

  @@index([email])
  @@index([role])
  @@index([isMinor])
  @@index([isSimulated])
}

enum Role {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

// Signed smart links with attribution
model SignedLink {
  id        String @id @default(cuid())
  shortCode String @unique
  signature String

  // Payload data
  persona String
  context String
  loop    String

  referrerId String
  referrer   User   @relation("Referrer", fields: [referrerId], references: [id])

  // Metadata
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  metadata  Json?

  // Relations
  attributions Attribution[]
  events       Event[]

  @@index([shortCode])
  @@index([referrerId])
  @@index([loop])
  @@index([createdAt])
}

// Attribution tracking (last-touch and multi-touch)
model Attribution {
  id String @id @default(cuid())

  signedLinkId String
  signedLink   SignedLink @relation(fields: [signedLinkId], references: [id])

  userId String
  user   User   @relation("Referred", fields: [userId], references: [id])

  // Touchpoint tracking
  touchpoint String
  ipAddress  String?
  userAgent  String?
  deviceId   String?

  createdAt DateTime @default(now())

  @@index([signedLinkId])
  @@index([userId])
  @@index([touchpoint])
  @@index([createdAt])
}

// Event tracking for analytics
model Event {
  id   String @id @default(cuid())
  type String

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  sessionId String?
  surface   String

  // Loop context
  loop         String?
  signedLinkId String?
  signedLink   SignedLink? @relation(fields: [signedLinkId], references: [id])

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())
  
  // Simulation tracking
  isSimulated  Boolean @default(false)
  simulationId String?

  @@index([type])
  @@index([userId])
  @@index([isSimulated])
  @@index([loop])
  @@index([sessionId])
  @@index([createdAt])
}

// Experiment assignments and cohorts
model Experiment {
  id   String @id @default(cuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  cohort  String
  variant String?

  assignedAt DateTime @default(now())
  metadata   Json?

  @@unique([name, userId])
  @@index([name])
  @@index([cohort])
}

// Viral loop configuration
model Loop {
  id          String @id @default(cuid())
  name        String @unique
  displayName String

  // Configuration
  active      Boolean @default(true)
  triggers    Json
  eligibility Json
  rewards     Json
  throttle    Json?

  // Personalization
  copyTemplates Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// Session transcription and summaries
model Session {
  id   String @id @default(cuid())
  type String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tutorId String?
  subject String

  // Transcription
  transcribed   Boolean @default(false)
  transcription String? @db.Text
  summary       Json?

  // Session data
  startedAt DateTime
  endedAt   DateTime?
  duration  Int?
  rating    Float?

  // Agentic actions triggered
  actions AgenticAction[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tutorId])
  @@index([subject])
  @@index([transcribed])
  @@index([startedAt])
}

// Agentic actions triggered from sessions
model AgenticAction {
  id   String @id @default(cuid())
  type String

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  targetPersona String

  // Action details
  payload    Json
  executed   Boolean   @default(false)
  executedAt DateTime?

  // Viral tracking
  invitesSent   Int @default(0)
  invitesOpened Int @default(0)
  conversions   Int @default(0)

  createdAt DateTime @default(now())

  @@index([type])
  @@index([sessionId])
  @@index([targetPersona])
  @@index([executed])
}

// Results pages for async tools (diagnostics, practice tests, etc.)
model ResultsPage {
  id   String @id @default(cuid())
  type String

  userId  String
  subject String

  // Results data
  score           Float
  skillsHeatmap   Json
  recommendations Json

  // Share tracking
  shareCardGenerated Boolean @default(false)
  shareCount         Int     @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([subject])
  @@index([createdAt])
}

// Agent decision logs for auditability
model AgentDecision {
  id    String @id @default(cuid())
  agent String

  decision     Json
  rationale    String
  featuresUsed Json

  // Context
  userId    String?
  sessionId String?
  loop      String?

  latencyMs Int?

  createdAt DateTime @default(now())

  @@index([agent])
  @@index([userId])
  @@index([createdAt])
}

// Fraud and abuse tracking
model FraudFlag {
  id String @id @default(cuid())

  userId    String?
  deviceId  String?
  ipAddress String?
  email     String?

  reason   String
  severity String

  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([deviceId])
  @@index([ipAddress])
  @@index([severity])
  @@index([resolved])
}

// Complaints and opt-outs
model Complaint {
  id String @id @default(cuid())

  userId String?
  email  String?

  type        String
  description String? @db.Text

  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([resolved])
}
