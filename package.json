{
  "name": "vt-kfactor",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,agents,attr \"pnpm --filter @app/web dev\" \"pnpm --filter @app/agents dev\" \"pnpm --filter @app/attribution dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:format:check": "prisma format --check",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "ci": "pnpm install && pnpm prisma:generate && pnpm typecheck && pnpm build && pnpm test",
    "ci:check": "echo '🔍 Running local CI checks...' && pnpm prisma:validate && pnpm prisma:format:check && pnpm typecheck && pnpm build && pnpm test && echo '✅ All CI checks passed!'"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prisma": "^6.18.0",
    "@prisma/client": "^6.18.0",
    "tsx": "^4.19.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}