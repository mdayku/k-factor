{
  "name": "vt-kfactor",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,agents,attr \"pnpm --filter @app/web dev\" \"pnpm --filter @app/agents dev\" \"pnpm --filter @app/attribution dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:format:check": "prisma format --check",
    "prisma:generate": "prisma generate",
    "ci": "pnpm install && pnpm prisma:generate && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}