# ========================================
# IMPORTANT: Copy this file to apps/web/.env.local
# Next.js looks for .env.local in the apps/web/ directory!
# ========================================

# Database (Supabase)
# Get from Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use Session Pooler (port 6543) for app connections, not Direct Connection (5432)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.xxx.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (same as DATABASE_URL for Supabase Session Pooler)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# NextAuth.js (REQUIRED for authentication)
# Generate secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=GENERATE_A_RANDOM_SECRET_HERE

# OAuth Providers (optional - can test email/password auth without these)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# APPLE_ID=your_apple_id
# APPLE_SECRET=your_apple_secret

# API URLs (for development)
NEXT_PUBLIC_AGENTS_URL="http://localhost:4000"
NEXT_PUBLIC_ATTRIBUTION_URL="http://localhost:4100"
NEXT_PUBLIC_EVENTS_URL="http://localhost:4000/events"

# Attribution & Smart Links
SIGNED_LINK_SECRET="your-signed-link-secret-here"

# External Services (to be configured)
# Transcription service
TRANSCRIPTION_API_URL=""
TRANSCRIPTION_API_KEY=""

# Error tracking (Sentry, etc.)
SENTRY_DSN=""

# Monitoring (Datadog, etc.)
DATADOG_API_KEY=""

# Redis (for caching and queues)
REDIS_URL="redis://localhost:6379"

# Feature Flags
ENABLE_SESSION_TRANSCRIPTION="false"
ENABLE_AGENTIC_ACTIONS="false"
ENABLE_MCP_PROTOCOL="false"

# Compliance
COPPA_MODE="true"
DATA_RETENTION_DAYS="730"

# Rate Limiting
MAX_INVITES_PER_DAY="20"
MAX_INVITES_PER_HOUR="5"

