# ========================================
# IMPORTANT: Copy this file to apps/web/.env.local
# Next.js looks for .env.local in the apps/web/ directory!
# ========================================

# Database (Supabase)
# Get from Supabase Dashboard → Project Settings → Database → Connection string (URI)
# 
# DATABASE_URL: Used by app for queries (Session Pooler - port 6543)
# DIRECT_URL: Used by Prisma CLI for migrations (Transaction Pooler - port 6432, or Session Pooler if 6432 blocked)
# 
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.xxx.pooler.supabase.com:PORT/postgres?pgbouncer=true
# 
# NOTE: If ports 5432/6432 are blocked on your network (common in corporate environments),
# use the Session Pooler (6543) for BOTH, and run migrations via Supabase SQL Editor instead.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# For migrations: Try port 6432 first, fallback to 6543 if blocked
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxx.pooler.supabase.com:6432/postgres"

# NextAuth.js (REQUIRED for authentication)
# Generate secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=GENERATE_A_RANDOM_SECRET_HERE

# OAuth Providers (optional - can test email/password auth without these)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# APPLE_ID=your_apple_id
# APPLE_SECRET=your_apple_secret

# API URLs (for development)
NEXT_PUBLIC_AGENTS_URL="http://localhost:4000"
NEXT_PUBLIC_ATTRIBUTION_URL="http://localhost:4100"
NEXT_PUBLIC_EVENTS_URL="http://localhost:4000/events"

# Attribution & Smart Links
SIGNED_LINK_SECRET="your-signed-link-secret-here"

# AI / LLM Integration (REQUIRED for AI-powered agents)
# Get API key from: https://platform.openai.com/api-keys
# Used by Personalization Agent for dynamic copy generation
# Cost: ~$0.002 per invite with GPT-4o-mini
# If not set, agents will fall back to static templates from Copy Kit
OPENAI_API_KEY="your-openai-api-key-here"

# External Services (to be configured)
# Transcription service
TRANSCRIPTION_API_URL=""
TRANSCRIPTION_API_KEY=""

# Error tracking (Sentry, etc.)
SENTRY_DSN=""

# Monitoring (Datadog, etc.)
DATADOG_API_KEY=""

# Redis (for caching and queues)
REDIS_URL="redis://localhost:6379"

# Feature Flags
ENABLE_SESSION_TRANSCRIPTION="false"
ENABLE_AGENTIC_ACTIONS="false"
ENABLE_MCP_PROTOCOL="false"

# Compliance
COPPA_MODE="true"
DATA_RETENTION_DAYS="730"

# Rate Limiting
MAX_INVITES_PER_DAY="20"
MAX_INVITES_PER_HOUR="5"

